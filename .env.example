DJANGO_SECRET_KEY=dev-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

APP_DB_NAME=app_db
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_HOST=localhost
APP_DB_PORT=5432

# Portal DB defaults (TEST): local/dev usually use portal_db_test
PORTAL_DB_NAME=portal_db_test
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=portal
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432

# Explicit test profile values for admin button "Тестовая БД"
PORTAL_DB_TEST_NAME=portal_db_test
PORTAL_DB_TEST_USER=portal
PORTAL_DB_TEST_PASSWORD=portal
PORTAL_DB_TEST_HOST=localhost
PORTAL_DB_TEST_PORT=5432

# Typical production Portal DB name
# PORTAL_DB_PROD_NAME=portal_db

# Optional Fernet key for encrypting portal DB password in app_db
# If unset, key is derived from DJANGO_SECRET_KEY
# PORTAL_DB_FERNET_KEY=<32-byte-urlsafe-base64-key>

SEMANTIC_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# SEMANTIC_MODEL_PATH=/opt/models/paraphrase-multilingual-MiniLM-L12-v2

# Offline mode flags (set to 1 in closed contour)
OFFLINE_MODE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional: skip model loading for lightweight runs/tests
SKIP_SEMANTIC_MODEL=false

PORTAL_GATEWAY_BACKEND=orm
# PORTAL_PROFILE=dev
# PORTAL_CONFIG_PATH=configs/portal/portal.yml
